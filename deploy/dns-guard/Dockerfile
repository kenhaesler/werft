# Werft-owned (CD M4); same Rocky org base as the runner/egress-proxy images, digest-pinned.
# Resolved via: docker buildx imagetools inspect rockylinux/rockylinux:10
FROM rockylinux/rockylinux@sha256:827d37bc128288ccf160ee318bb3cb92d591164cb217e92f8bc61e3982ae1834
RUN dnf install -y --setopt=install_weak_deps=False dnsmasq && dnf clean all \
 && mkdir -p /var/log/dnsguard /etc/dnsmasq.d
COPY dnsmasq.conf /etc/dnsmasq.conf
# dns-allow.conf is bind-mounted from /opt/werft/config/dns-allow.conf at runtime
# (generated by gen-dns-allow.sh, not baked); the baked empty file only satisfies --test.
RUN : > /etc/dnsmasq.d/dns-allow.conf && dnsmasq --test
CMD ["dnsmasq", "--no-daemon"]
