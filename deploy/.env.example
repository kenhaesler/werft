POSTGRES_IMAGE=postgres:18-alpine@sha256:RESOLVE-AT-DEPLOY
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy@sha256:RESOLVE-AT-DEPLOY
GITHUB_APP_CLIENT_ID=
NTFY_URL=
# SPEC §7 dispatch quota ceiling, in seconds of agent wall-clock per window.
# Empty/unset means 0, at which the dispatch plane never claims a run and the
# manager logs `app.dispatch_disabled_no_quota_ceiling` once at boot — a host
# that looks healthy and never dispatches. Set it deliberately, e.g. 18000 (5h).
QUOTA_CEILING_SECONDS=
